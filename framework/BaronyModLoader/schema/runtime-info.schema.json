{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/runtime-info.schema.json",
  "title": "BaronyModLoader v0 runtime info",
  "description": "Describes a discovered BaronyModLoader engine runtime: supported contract versions, game revisions, platforms, capabilities, and policy flags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtimeId",
    "runtimeVersion",
    "runtimeName",
    "gameRevision",
    "contractVersions",
    "executable",
    "game",
    "contract",
    "platforms",
    "capabilities",
    "moduleSupport",
    "runtimeReportPaths",
    "policy"
  ],
  "properties": {
    "runtimeId": { "$ref": "#/$defs/id" },
    "runtimeVersion": { "$ref": "#/$defs/version" },
    "runtimeName": { "type": "string", "minLength": 1 },
    "gameRevision": { "type": "string", "minLength": 1 },
    "contractVersions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    },
    "executable": { "$ref": "#/$defs/absolutePath" },
    "game": { "$ref": "#/$defs/game" },
    "contract": { "$ref": "#/$defs/contract" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/platform" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runtimeCapability" }
    },
    "moduleSupport": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "persistentStorage",
          "persistentInventories",
          "voidChestBindings",
          "placements",
          "multiplayer"
        ]
      },
      "uniqueItems": true
    },
    "runtimeReportPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeManifest",
        "runtimeLoadReport",
        "runtimeLog",
        "stateRoot"
      ],
      "properties": {
        "runtimeManifest": { "$ref": "#/$defs/profilePath" },
        "runtimeLoadReport": { "$ref": "#/$defs/profilePath" },
        "runtimeLog": { "$ref": "#/$defs/profilePath" },
        "stateRoot": { "$ref": "#/$defs/profilePath" }
      }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+"
    },
    "profilePath": {
      "type": "string",
      "pattern": "^BaronyModLoader/.+"
    },
    "capabilityId": {
      "type": "string",
      "enum": [
        "persistent_storage",
        "persistent_inventory",
        "void_chest_binding",
        "placement_lobby",
        "placement_shop",
        "multiplayer_version_metadata",
        "runtime_load_smoke"
      ]
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/version" },
        "required": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "runtimeCapability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "requiredForStash"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/version" },
        "requiredForStash": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "supportedVersions", "revision"],
      "properties": {
        "id": { "const": "barony" },
        "name": { "const": "Barony" },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versions"],
      "properties": {
        "id": { "const": "bml-runtime-contract" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "executable", "artifact", "sha256"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "executable": { "$ref": "#/$defs/absolutePath" },
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresValidatedManifest",
        "rejectsUnknownRequiredCapabilities",
        "partialStashLoadAllowed"
      ],
      "properties": {
        "runtimeStrategy": { "type": "string", "minLength": 1 },
        "requiresValidatedManifest": { "type": "boolean" },
        "rejectsUnknownRequiredCapabilities": { "type": "boolean" },
        "partialStashLoadAllowed": { "type": "boolean" },
        "windowsSupportLevel": { "type": "string", "enum": ["noop-runtime-load", "stash-runtime-fail-closed", "stash-runtime-supported"] }
      }
    }
  }
}
