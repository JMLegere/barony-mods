{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/profile.schema.json",
  "title": "BaronyModLoader v0 profile activation record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "app", "paths", "activeMods", "runtime"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "BaronyModLoader" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profileRoot", "bmlRoot", "logs", "reports", "manifests", "state", "runtimeManifest"],
      "properties": {
        "profileRoot": { "type": "string", "minLength": 1 },
        "bmlRoot": { "type": "string", "minLength": 1 },
        "logs": { "type": "string", "minLength": 1 },
        "reports": { "type": "string", "minLength": 1 },
        "manifests": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "runtimeManifest": { "type": "string", "minLength": 1 }
      }
    },
    "activeMods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "version", "packagePath"],
        "properties": {
          "id": { "$ref": "#/$defs/packageId" },
          "version": { "$ref": "#/$defs/version" },
          "packagePath": { "type": "string", "minLength": 1 },
          "manifestPath": { "type": "string", "minLength": 1 },
          "checksumSet": { "type": "string", "minLength": 1 },
          "loadOrder": { "type": "integer", "minimum": 0 },
          "enabled": { "type": "boolean" },
          "enabledAt": { "$ref": "#/$defs/dateTime" },
          "capabilities": {
            "type": "array",
            "items": { "$ref": "#/$defs/capabilityRequest" }
          },
          "modules": {
            "type": "array",
            "items": { "type": "string", "enum": ["persistentStorage", "persistentInventories", "voidChestBindings", "placements", "multiplayer"] },
            "uniqueItems": true
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gameSource", "baronyExecutable"],
      "properties": {
        "gameSource": { "type": "string", "enum": ["manual", "steam"] },
        "baronyExecutable": { "type": "string", "minLength": 1 },
        "runtimeInfo": { "type": ["string", "null"] },
        "steam": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "source": { "const": "steam" },
            "appId": { "const": "371970" },
            "name": { "type": "string" },
            "buildId": { "type": ["string", "null"] },
            "manifestPath": { "type": ["string", "null"] },
            "installPath": { "type": "string", "minLength": 1 },
            "executable": { "type": "string", "minLength": 1 },
            "assetsRoot": { "type": "string", "minLength": 1 },
            "compatibility": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "stockExecutablePatched": { "const": false },
                "requiresBmlRuntimeExecutable": { "type": "boolean" },
                "runtimeUsesSteamAssets": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string", "enum": ["valid", "invalid", "warning"] },
        "checkedAt": { "$ref": "#/$defs/dateTime" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "profilePath": { "type": "string", "pattern": "^BaronyModLoader/.+" },
    "capabilityId": {
      "type": "string",
      "enum": ["persistent_storage", "persistent_inventory", "void_chest_binding", "placement_lobby", "placement_shop", "multiplayer_version_metadata"]
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/version" },
        "required": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "runtimeCapability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/version" },
        "description": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "severity", "message", "action"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["info", "warning", "error", "fatal"] },
        "message": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}
