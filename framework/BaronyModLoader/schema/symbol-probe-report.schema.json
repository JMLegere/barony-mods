{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/symbol-probe-report.schema.json",
  "title": "BaronyModLoader symbol probe report",
  "description": "Native hook report written after resolving required installed-executable symbols with dlsym(RTLD_DEFAULT, mangled symbol). A loaded report proves symbol/provenance readiness only; it does not prove gameplay hooks were installed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "profileId",
    "status",
    "summary",
    "symbols",
    "errors",
    "reportedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "profileId": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "type": "string",
      "enum": [
        "loaded",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "resolved",
        "missing"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbolResult"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reportError"
      }
    },
    "reportedAt": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "strategy",
        "gameRevision",
        "executable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "strategy": {
          "const": "installed-binary-hook"
        },
        "gameRevision": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "symbolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "kind",
        "required",
        "status",
        "address"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "data"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "missing"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]+$"
        }
      }
    },
    "reportError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "symbol",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BML_HOOK_SYMBOL_MISSING"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "fatal"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
