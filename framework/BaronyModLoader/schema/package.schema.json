{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/package.schema.json",
  "title": "BaronyModLoader v0 package manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "formatVersion",
    "id",
    "name",
    "version",
    "kind",
    "summary",
    "authors",
    "layout",
    "barony",
    "framework",
    "engine",
    "modules",
    "native",
    "dependencies",
    "conflicts",
    "runtimeReports"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "#/$defs/packageId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "kind": {
      "type": "string",
      "enum": [
        "gameplay-mod",
        "content-pack",
        "library",
        "runtime-support"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "contentRoot",
        "assetRoot",
        "nativeRoot",
        "migrationRoot"
      ],
      "additionalProperties": false,
      "properties": {
        "contentRoot": {
          "$ref": "#/$defs/relativeDirectory"
        },
        "assetRoot": {
          "$ref": "#/$defs/relativeDirectory"
        },
        "nativeRoot": {
          "$ref": "#/$defs/relativeDirectory"
        },
        "migrationRoot": {
          "$ref": "#/$defs/relativeDirectory"
        }
      }
    },
    "barony": {
      "type": "object",
      "required": [
        "supportedGameVersions",
        "upstreamRepository"
      ],
      "additionalProperties": true,
      "properties": {
        "supportedGameVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "officialContentSystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstreamRepository": {
          "type": "string",
          "minLength": 1
        },
        "workingForkRepository": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "framework": {
      "type": "object",
      "required": [
        "id",
        "minimumAppVersion",
        "packageSchema",
        "runtimeContract"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "const": "BaronyModLoader"
        },
        "minimumAppVersion": {
          "$ref": "#/$defs/version"
        },
        "packageSchema": {
          "const": "bml-package@0.1.0"
        },
        "runtimeContract": {
          "const": "bml-runtime-contract@0.1.0"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "previewImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readme": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "runtimeContract",
        "minimumRuntimeVersion",
        "capabilities"
      ],
      "additionalProperties": true,
      "properties": {
        "runtimeContract": {
          "const": "bml-runtime-contract@0.1.0"
        },
        "minimumRuntimeVersion": {
          "$ref": "#/$defs/version"
        },
        "capabilities": {
          "$ref": "#/$defs/requiredCapabilitySet"
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistentStorage": {
          "type": "object",
          "required": [
            "namespace",
            "scope",
            "savePolicy",
            "schemaVersion",
            "failurePolicy"
          ],
          "additionalProperties": true,
          "properties": {
            "namespace": {
              "$ref": "#/$defs/idFragment"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "savePolicy": {
              "type": "string",
              "minLength": 1
            },
            "fileHint": {
              "$ref": "#/$defs/relativePath"
            },
            "schemaVersion": {
              "$ref": "#/$defs/version"
            },
            "failurePolicy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistentInventories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "storageKey",
              "scope",
              "authority",
              "access",
              "savePolicy",
              "itemEncoding",
              "failurePolicy"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "$ref": "#/$defs/idFragment"
              },
              "displayName": {
                "type": "string"
              },
              "storageKey": {
                "$ref": "#/$defs/idFragment"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "type": "string",
                "minLength": 1
              },
              "savePolicy": {
                "type": "string",
                "minLength": 1
              },
              "itemEncoding": {
                "type": "string",
                "minLength": 1
              },
              "preserves": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "failurePolicy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "voidChestBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "inventory",
              "source",
              "mode",
              "exclusive"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "$ref": "#/$defs/idFragment"
              },
              "inventory": {
                "$ref": "#/$defs/idFragment"
              },
              "source": {
                "$ref": "#/$defs/idFragment"
              },
              "mode": {
                "type": "string",
                "minLength": 1
              },
              "exclusive": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "hook",
              "entity",
              "inventory",
              "frequency",
              "placementPolicy",
              "deterministic",
              "failurePolicy"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "$ref": "#/$defs/idFragment"
              },
              "hook": {
                "$ref": "#/$defs/idFragment"
              },
              "entity": {
                "$ref": "#/$defs/idFragment"
              },
              "inventory": {
                "$ref": "#/$defs/idFragment"
              },
              "frequency": {
                "type": "string",
                "minLength": 1
              },
              "placementPolicy": {
                "type": "string",
                "minLength": 1
              },
              "deterministic": {
                "type": "boolean"
              },
              "failurePolicy": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "multiplayer": {
          "type": "object",
          "required": [
            "policy",
            "versionPolicy",
            "syncInventories",
            "clientCompatibility",
            "failurePolicy"
          ],
          "additionalProperties": true,
          "properties": {
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "versionPolicy": {
              "type": "string",
              "minLength": 1
            },
            "syncInventories": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/idFragment"
              }
            },
            "clientCompatibility": {
              "type": "object",
              "additionalProperties": true
            },
            "failurePolicy": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "runeboundElixirs": {
          "type": "object",
          "required": [
            "namespace",
            "schemaVersion",
            "authority",
            "carrierItemType",
            "dataFiles",
            "dropPolicy",
            "activeEffects",
            "display",
            "multiplayer",
            "failurePolicy"
          ],
          "additionalProperties": true,
          "properties": {
            "namespace": {
              "const": "runebound_elixirs"
            },
            "schemaVersion": {
              "const": "0.1.0"
            },
            "authority": {
              "const": "host"
            },
            "carrierItemType": {
              "const": "POTION_EMPTY"
            },
            "dataFiles": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/relativePath"
              },
              "uniqueItems": true,
              "allOf": [
                {
                  "contains": {
                    "const": "content/data/bml/elixir-catalog.json"
                  }
                },
                {
                  "contains": {
                    "const": "content/data/bml/elixir-drop-tables.json"
                  }
                }
              ]
            },
            "dropPolicy": {
              "type": "object",
              "required": [
                "eligibleClasses",
                "soloClassPolicy",
                "partySizeEligibility",
                "rngAuthority"
              ],
              "additionalProperties": true,
              "properties": {
                "eligibleClasses": {
                  "const": "present_party_classes"
                },
                "soloClassPolicy": {
                  "const": "local_player_only"
                },
                "partySizeEligibility": {
                  "const": "generation_time_only"
                },
                "rngAuthority": {
                  "const": "host"
                }
              }
            },
            "activeEffects": {
              "type": "object",
              "required": [
                "stateScope",
                "stateFile",
                "savePolicy",
                "duplicatePolicy",
                "failurePolicy"
              ],
              "additionalProperties": true,
              "properties": {
                "stateScope": {
                  "type": "string",
                  "minLength": 1
                },
                "stateFile": {
                  "$ref": "#/$defs/relativePath"
                },
                "savePolicy": {
                  "type": "string",
                  "minLength": 1
                },
                "duplicatePolicy": {
                  "type": "string",
                  "minLength": 1
                },
                "failurePolicy": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "display": {
              "type": "object",
              "required": [
                "nameRendering",
                "tooltipRendering",
                "consumeMessages",
                "reminderPolicy"
              ],
              "additionalProperties": true,
              "properties": {
                "nameRendering": {
                  "type": "string",
                  "minLength": 1
                },
                "tooltipRendering": {
                  "type": "string",
                  "minLength": 1
                },
                "consumeMessages": {
                  "type": "string",
                  "minLength": 1
                },
                "reminderPolicy": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "multiplayer": {
              "type": "object",
              "required": [
                "versionPolicy",
                "stateAuthority",
                "clientCompatibility",
                "failurePolicy"
              ],
              "additionalProperties": true,
              "properties": {
                "versionPolicy": {
                  "type": "string",
                  "minLength": 1
                },
                "stateAuthority": {
                  "const": "host"
                },
                "clientCompatibility": {
                  "type": "object",
                  "additionalProperties": true
                },
                "failurePolicy": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "failurePolicy": {
              "const": "fail-closed"
            }
          }
        }
      }
    },
    "native": {
      "type": "object",
      "required": [
        "required",
        "mode",
        "plugins",
        "patches",
        "builds"
      ],
      "additionalProperties": true,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "paired-engine-runtime",
            "none"
          ]
        },
        "plugins": {
          "type": "array",
          "maxItems": 0
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "appliesTo",
              "baseRevision",
              "path",
              "required",
              "providesCapabilities"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "$ref": "#/$defs/idFragment"
              },
              "appliesTo": {
                "type": "string",
                "minLength": 1
              },
              "baseRevision": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "required": {
                "type": "boolean"
              },
              "providesCapabilities": {
                "$ref": "#/$defs/capabilityIdList"
              },
              "reviewStance": {
                "type": "string"
              }
            }
          }
        },
        "builds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "platform",
              "baronyRevision",
              "runtimeVersion",
              "artifact"
            ],
            "additionalProperties": true,
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "baronyRevision": {
                "type": "string",
                "minLength": 1
              },
              "runtimeVersion": {
                "$ref": "#/$defs/version"
              },
              "artifact": {
                "$ref": "#/$defs/relativePath"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "runtimeStrategy": {
          "type": "string",
          "enum": [
            "installed-binary-hook",
            "none"
          ]
        },
        "runtimeAuthority": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "platform",
              "hostOs",
              "gameExecutableName",
              "artifactExtension",
              "launchAdapter",
              "verificationStatus"
            ],
            "additionalProperties": true,
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "hostOs": {
                "type": "string",
                "enum": [
                  "linux",
                  "windows",
                  "macos"
                ]
              },
              "gameExecutableName": {
                "type": "string",
                "minLength": 1
              },
              "hookArtifact": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "hookLibraryName": {
                "type": "string",
                "minLength": 1
              },
              "artifactExtension": {
                "type": "string",
                "minLength": 1
              },
              "launchAdapter": {
                "type": "string",
                "enum": [
                  "linux-ld-preload",
                  "windows-createprocess-loadlibrary"
                ]
              },
              "launcherExecutable": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "verificationStatus": {
                "type": "string",
                "minLength": 1
              },
              "liveInstallReport": {
                "$ref": "#/$defs/profileRelativePath"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "contains": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "required"
        ],
        "properties": {
          "id": {
            "const": "bml.runtime"
          },
          "kind": {
            "const": "engine-runtime"
          },
          "required": {
            "const": true
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "reason"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "loadAfter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packageId"
      }
    },
    "loadBefore": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packageId"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "to",
          "phase",
          "path",
          "idempotent"
        ],
        "additionalProperties": true
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "additionalProperties": true
    },
    "runtimeReports": {
      "type": "object",
      "required": [
        "paths",
        "expectedLoadedCapabilities",
        "expectedLoadedModules",
        "blockOnErrors"
      ],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "object",
          "required": [
            "runtimeManifest",
            "runtimeLoadReport",
            "runtimeLog",
            "validationReport"
          ],
          "additionalProperties": false,
          "properties": {
            "runtimeManifest": {
              "$ref": "#/$defs/profileRelativePath"
            },
            "runtimeLoadReport": {
              "$ref": "#/$defs/profileRelativePath"
            },
            "runtimeLog": {
              "$ref": "#/$defs/profileRelativePath"
            },
            "validationReport": {
              "$ref": "#/$defs/profileRelativePath"
            },
            "liveInstallReport": {
              "$ref": "#/$defs/profileRelativePath"
            }
          }
        },
        "expectedLoadedCapabilities": {
          "$ref": "#/$defs/capabilityIdSet"
        },
        "expectedLoadedModules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "persistentStorage",
              "persistentInventories",
              "voidChestBindings",
              "placements",
              "multiplayer",
              "runeboundElixirs"
            ]
          },
          "uniqueItems": true
        },
        "blockOnErrors": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "const": "jml.stash"
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "engine": {
            "properties": {
              "capabilities": {
                "$ref": "#/$defs/stashRequiredCapabilitySet"
              }
            }
          },
          "modules": {
            "required": [
              "persistentStorage",
              "persistentInventories",
              "voidChestBindings",
              "placements",
              "multiplayer"
            ]
          },
          "native": {
            "properties": {
              "mode": {
                "const": "paired-engine-runtime"
              },
              "patches": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "jml.runebound-elixirs"
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "engine": {
            "properties": {
              "capabilities": {
                "$ref": "#/$defs/runeboundElixirsRequiredCapabilitySet"
              }
            }
          },
          "modules": {
            "required": [
              "runeboundElixirs"
            ]
          },
          "runtimeReports": {
            "properties": {
              "expectedLoadedCapabilities": {
                "$ref": "#/$defs/runeboundElixirsCapabilitySet"
              },
              "expectedLoadedModules": {
                "contains": {
                  "const": "runeboundElixirs"
                }
              },
              "paths": {
                "required": [
                  "liveInstallReport"
                ],
                "properties": {
                  "liveInstallReport": {
                    "const": "BaronyModLoader/reports/runebound-elixir-live-install-report.json"
                  }
                }
              }
            }
          },
          "native": {
            "required": [
              "required",
              "mode",
              "runtimeStrategy",
              "runtimeAuthority",
              "platforms"
            ],
            "properties": {
              "required": {
                "const": true
              },
              "mode": {
                "const": "paired-engine-runtime"
              },
              "runtimeStrategy": {
                "const": "installed-binary-hook"
              },
              "runtimeAuthority": {
                "type": "string",
                "minLength": 1
              },
              "platforms": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "idFragment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))"
      }
    },
    "relativeDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "/$",
      "not": {
        "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))"
      }
    },
    "profileRelativePath": {
      "type": "string",
      "pattern": "^BaronyModLoader/.+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
