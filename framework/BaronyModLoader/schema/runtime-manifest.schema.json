{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/runtime-manifest.schema.json",
  "title": "BaronyModLoader v0 runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "app", "launch", "mods"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "bml-runtime-contract" },
        "version": { "const": "0.1.0" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "BaronyModLoader" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profileId", "gameInstallId", "baronyExecutable", "createdAt"],
      "properties": {
        "profileId": { "$ref": "#/$defs/id" },
        "gameInstallId": { "$ref": "#/$defs/id" },
        "baronyExecutable": { "$ref": "#/$defs/absolutePath" },
        "createdAt": { "type": "string", "format": "date-time" },
        "runtimeLoadReport": { "$ref": "#/$defs/profilePath" },
        "runtimeLog": { "$ref": "#/$defs/profilePath" },
        "stateRoot": { "$ref": "#/$defs/profilePath" }
      }
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "packagePath", "checksumSet", "loadOrder", "capabilities", "modules"],
        "properties": {
          "id": { "$ref": "#/$defs/packageId" },
          "version": { "$ref": "#/$defs/version" },
          "packagePath": { "$ref": "#/$defs/absolutePath" },
          "checksumSet": { "type": "string", "minLength": 1 },
          "loadOrder": { "type": "integer", "minimum": 0 },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/capabilityRequest" }
          },
          "modules": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "persistentStorage": { "$ref": "#/$defs/persistentStorageModule" },
              "persistentInventories": { "type": "array", "items": { "$ref": "#/$defs/persistentInventoryModule" } },
              "voidChestBindings": { "type": "array", "items": { "$ref": "#/$defs/voidChestBindingModule" } },
              "placements": { "type": "array", "items": { "$ref": "#/$defs/placementModule" } },
              "multiplayer": { "$ref": "#/$defs/multiplayerModule" }
            }
          },
          "stateNamespace": { "$ref": "#/$defs/id" },
          "migrations": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "absolutePath": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+" },
    "profilePath": { "type": "string", "pattern": "^BaronyModLoader/.+" },
    "capabilityId": {
      "type": "string",
      "enum": ["persistent_storage", "persistent_inventory", "void_chest_binding", "placement_lobby", "placement_shop", "multiplayer_version_metadata"]
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "version", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/version" },
        "required": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "persistentStorageModule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["namespace", "scope", "savePolicy", "schemaVersion", "failurePolicy"],
      "properties": {
        "namespace": { "$ref": "#/$defs/id" },
        "scope": { "type": "string", "minLength": 1 },
        "savePolicy": { "type": "string", "minLength": 1 },
        "fileHint": { "type": "string" },
        "schemaVersion": { "$ref": "#/$defs/version" },
        "failurePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "persistentInventoryModule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "storageKey", "scope", "authority", "access", "savePolicy", "itemEncoding", "failurePolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "storageKey": { "$ref": "#/$defs/id" },
        "scope": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "minLength": 1 },
        "savePolicy": { "type": "string", "minLength": 1 },
        "itemEncoding": { "type": "string", "minLength": 1 },
        "preserves": { "type": "array", "items": { "type": "string" } },
        "failurePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "voidChestBindingModule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "inventory", "source", "mode", "exclusive"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "inventory": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/id" },
        "mode": { "type": "string", "minLength": 1 },
        "exclusive": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "placementModule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "hook", "entity", "inventory", "frequency", "placementPolicy", "deterministic", "failurePolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "hook": { "$ref": "#/$defs/id" },
        "entity": { "$ref": "#/$defs/id" },
        "inventory": { "$ref": "#/$defs/id" },
        "frequency": { "type": "string", "minLength": 1 },
        "placementPolicy": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" },
        "failurePolicy": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "multiplayerModule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["policy", "versionPolicy", "syncInventories", "clientCompatibility", "failurePolicy"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "versionPolicy": { "type": "string", "minLength": 1 },
        "syncInventories": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "clientCompatibility": { "type": "object", "additionalProperties": true },
        "failurePolicy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
