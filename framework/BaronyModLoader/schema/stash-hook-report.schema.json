{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/stash-hook-report.schema.json",
  "title": "BaronyModLoader Stash hook report",
  "description": "Native hook report for required Stash gameplay hook targets. Reports are backend-aware and fail closed until every required Stash gameplay hook is installed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "profileId",
    "mod",
    "backend",
    "status",
    "summary",
    "hooks",
    "errors",
    "reportedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "profileId": {
      "$ref": "#/$defs/id"
    },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifestDetected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:\\.[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "manifestDetected": {
          "type": "boolean"
        }
      }
    },
    "backend": {
      "$ref": "#/$defs/backend"
    },
    "status": {
      "type": "string",
      "enum": [
        "installed",
        "failed",
        "not_applicable"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "installed",
        "ready",
        "blocked",
        "notInstalled",
        "failClosed"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "installed": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "notInstalled": {
          "type": "integer",
          "minimum": 0
        },
        "failClosed": {
          "type": "boolean"
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hookResult"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reportError"
      }
    },
    "reportedAt": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "properties": {
              "mode": {
                "const": "analyze-only"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "not": {
              "const": "installed"
            }
          },
          "hooks": {
            "items": {
              "properties": {
                "status": {
                  "not": {
                    "const": "installed"
                  }
                },
                "targets": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "status": {
                              "const": "blocked"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "blockerCode"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_applicable"
          }
        }
      },
      "then": {
        "properties": {
          "mod": {
            "properties": {
              "manifestDetected": {
                "const": false
              }
            }
          },
          "summary": {
            "properties": {
              "required": {
                "const": 0
              },
              "installed": {
                "const": 0
              },
              "ready": {
                "const": 0
              },
              "blocked": {
                "const": 0
              },
              "notInstalled": {
                "const": 0
              },
              "failClosed": {
                "const": false
              }
            }
          },
          "hooks": {
            "maxItems": 0
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "mod": {
            "properties": {
              "manifestDetected": {
                "const": true
              }
            }
          },
          "summary": {
            "properties": {
              "installed": {
                "const": 0
              },
              "notInstalled": {
                "minimum": 1
              },
              "failClosed": {
                "const": true
              }
            }
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "installed"
          }
        }
      },
      "then": {
        "properties": {
          "mod": {
            "properties": {
              "manifestDetected": {
                "const": true
              }
            }
          },
          "summary": {
            "properties": {
              "notInstalled": {
                "const": 0
              },
              "failClosed": {
                "const": false
              }
            }
          },
          "hooks": {
            "items": {
              "properties": {
                "status": {
                  "const": "installed"
                }
              }
            }
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "strategy",
        "gameRevision",
        "executable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "strategy": {
          "const": "installed-binary-hook"
        },
        "gameRevision": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "strategy",
        "patchBytes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "type": "string",
          "enum": [
            "analyze-only",
            "installing",
            "installed"
          ]
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "patchBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hookResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "required",
        "status",
        "description",
        "readyTargets",
        "blockedTargets",
        "missingTargets",
        "targets"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "capability": {
          "$ref": "#/$defs/id"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked",
            "installed",
            "failed",
            "not_applicable"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "readyTargets": {
          "type": "integer",
          "minimum": 0
        },
        "blockedTargets": {
          "type": "integer",
          "minimum": 0
        },
        "missingTargets": {
          "type": "integer",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hookTarget"
          }
        }
      }
    },
    "hookTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "kind",
        "status",
        "address",
        "message"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "data",
            "unknown"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked",
            "missing"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "patchWindowBytes": {
          "type": "integer",
          "minimum": 1
        },
        "blockerCode": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reportError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BML_STASH_HOOKS_NOT_INSTALLED"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "fatal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
