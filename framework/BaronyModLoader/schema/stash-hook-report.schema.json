{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/stash-hook-report.schema.json",
  "title": "BaronyModLoader Stash hook report",
  "description": "Native hook report for required Stash gameplay hook targets. Current reports fail closed because no relocation-safe detour layer is installed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "profileId",
    "mod",
    "status",
    "summary",
    "hooks",
    "errors",
    "reportedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "profileId": {
      "$ref": "#/$defs/id"
    },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifestDetected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:\\.[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "manifestDetected": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "failed",
        "not_applicable"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "installed",
        "notInstalled",
        "failClosed"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "installed": {
          "type": "integer",
          "minimum": 0
        },
        "notInstalled": {
          "type": "integer",
          "minimum": 0
        },
        "failClosed": {
          "type": "boolean"
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hookResult"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reportError"
      }
    },
    "reportedAt": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "strategy",
        "gameRevision",
        "executable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "strategy": {
          "const": "installed-binary-hook"
        },
        "gameRevision": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hookResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "status",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "not-installed"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reportError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BML_STASH_HOOKS_NOT_INSTALLED"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "fatal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
