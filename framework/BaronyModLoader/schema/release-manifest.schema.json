{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baronymodloader.local/schema/release-manifest.schema.json",
  "title": "BaronyModLoader v1 release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "createdAt",
    "app",
    "package",
    "runtime",
    "runtimeProvenance",
    "barony",
    "patchSeries",
    "buildArtifacts",
    "verification",
    "rollback"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "BaronyModLoader"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifestPath",
        "checksum",
        "archive",
        "installedPathShape"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/packageId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "manifestPath": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "checksum",
            "status"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repoRelativePath"
            },
            "checksum": {
              "$ref": "#/$defs/checksum"
            },
            "status": {
              "type": "string",
              "enum": [
                "packed_fixture",
                "release_artifact",
                "pending"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "installedPathShape": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "runtimeVersion",
        "requiredCapabilities",
        "status"
      ],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "const": "bml-runtime-contract"
            },
            "version": {
              "const": "0.1.0"
            }
          }
        },
        "runtimeVersion": {
          "$ref": "#/$defs/version"
        },
        "requiredCapabilities": {
          "$ref": "#/$defs/capabilityIdSet"
        },
        "status": {
          "type": "string",
          "enum": [
            "installed_binary_hook_contract_recorded_fail_closed",
            "runtime_binary_verified",
            "source_patch_artifacts_present_runtime_binary_pending",
            "pending",
            "installed_binary_hook_production_loaded_pending_player_scenarios",
            "installed_binary_hook_production_loaded_linux_only_windows_scaffold_pending"
          ]
        },
        "notes": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platformRuntimeSupport"
          },
          "minItems": 1
        }
      }
    },
    "runtimeProvenance": {
      "$ref": "#/$defs/installedBinaryHookProvenance"
    },
    "barony": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstreamRepository",
        "workingForkRepository",
        "sourceRevision",
        "sourceRevisionStatus",
        "compatibility"
      ],
      "properties": {
        "upstreamRepository": {
          "type": "string",
          "minLength": 1
        },
        "workingForkRepository": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevisionStatus": {
          "type": "string",
          "enum": [
            "semantic_reference_only",
            "verified",
            "pending_patched_build",
            "placeholder"
          ]
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supportedGameVersions",
            "status"
          ],
          "properties": {
            "supportedGameVersions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "installed_steam_linux_target_recorded_gameplay_pending",
                "source_patch_artifacts_present_built_game_pending",
                "verified_playable",
                "unknown",
                "installed_steam_linux_target_recorded_production_lobby_verified",
                "installed_steam_linux_target_recorded_windows_scaffold_pending"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "patchSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "patches"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "semantic_reference_only",
            "source_artifacts_present",
            "applied_to_verified_source",
            "pending"
          ]
        },
        "patches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/patchArtifact"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "buildArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifacts"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_applicable_installed_binary_hook",
            "pending_patched_build",
            "verified",
            "not_applicable"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildArtifact"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifactVerification",
        "installedHookVerification",
        "builtGameBehavior"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "installed_hook_fail_closed_gameplay_pending",
            "artifact_verified_built_game_pending",
            "verified_playable",
            "failed",
            "pending",
            "production_loaded_live_lobby_pending_player_scenarios",
            "production_loaded_linux_only_windows_scaffold_pending_player_scenarios"
          ]
        },
        "artifactVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "pending",
                "failed"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/repoRelativePath"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "installedHookVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "failClosed",
            "reports"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "fail_closed_pending_detours",
                "verified_playable",
                "failed",
                "pending",
                "production_loaded_with_historical_fail_closed_diagnostics",
                "linux_production_loaded_windows_scaffold_pending"
              ]
            },
            "failClosed": {
              "type": "boolean"
            },
            "reports": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/verificationReport"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "builtGameBehavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "requiredScenarios"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending_installed_hook_detours",
                "pending_patched_build",
                "complete",
                "failed",
                "production_lobby_verified_remaining_player_scenarios_pending",
                "linux_lobby_verified_windows_unverified_remaining_player_scenarios_pending"
              ]
            },
            "requiredScenarios": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notes",
        "steps"
      ],
      "properties": {
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))"
      }
    },
    "absoluteOrRepoPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": ".*(?:^|/)\\.\\.(?:/|$)"
      }
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "size"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capabilityId": {
      "type": "string",
      "enum": [
        "persistent_storage",
        "persistent_inventory",
        "void_chest_binding",
        "placement_lobby",
        "placement_shop",
        "multiplayer_version_metadata"
      ]
    },
    "capabilityIdSet": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/capabilityId"
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "persistent_storage"
          }
        },
        {
          "contains": {
            "const": "persistent_inventory"
          }
        },
        {
          "contains": {
            "const": "void_chest_binding"
          }
        },
        {
          "contains": {
            "const": "placement_lobby"
          }
        },
        {
          "contains": {
            "const": "placement_shop"
          }
        },
        {
          "contains": {
            "const": "multiplayer_version_metadata"
          }
        }
      ]
    },
    "installedBinaryHookProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeStrategy",
        "storefront",
        "platform",
        "gameVersion",
        "installedExecutable",
        "hookLibrary",
        "hookManifest",
        "runtimeInfo",
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "storefront": {
                "const": "steam"
              }
            },
            "required": [
              "storefront"
            ]
          },
          "then": {
            "required": [
              "steam"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "storefront": {
                "enum": [
                  "epic",
                  "gog",
                  "humble"
                ]
              }
            },
            "required": [
              "storefront"
            ]
          },
          "then": {
            "required": [
              "storefrontTarget"
            ],
            "not": {
              "required": [
                "steam"
              ]
            }
          }
        }
      ],
      "properties": {
        "runtimeStrategy": {
          "const": "installed-binary-hook"
        },
        "storefront": {
          "type": "string",
          "enum": [
            "steam",
            "epic",
            "gog",
            "humble"
          ]
        },
        "steam": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appId",
            "buildId"
          ],
          "properties": {
            "appId": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "buildId": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        },
        "storefrontTarget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "buildId": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "gameVersion": {
          "type": "string",
          "minLength": 1
        },
        "installedExecutable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pathHint",
            "sha256",
            "buildId",
            "status"
          ],
          "properties": {
            "pathHint": {
              "$ref": "#/$defs/absoluteOrRepoPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "buildId": {
              "$ref": "#/$defs/sha1"
            },
            "status": {
              "type": "string",
              "enum": [
                "verified_local_target",
                "pending",
                "mismatch"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "hookLibrary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "checksum",
            "status"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repoRelativePath"
            },
            "checksum": {
              "$ref": "#/$defs/checksum"
            },
            "status": {
              "type": "string",
              "enum": [
                "built_available_fail_closed",
                "available",
                "missing",
                "pending",
                "built_available_production_stash"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "hookManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "checksum",
            "status"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repoRelativePath"
            },
            "checksum": {
              "$ref": "#/$defs/checksum"
            },
            "status": {
              "type": "string",
              "enum": [
                "present",
                "missing",
                "pending"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "runtimeInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "checksum",
            "status"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repoRelativePath"
            },
            "checksum": {
              "$ref": "#/$defs/checksum"
            },
            "status": {
              "type": "string",
              "enum": [
                "present",
                "missing",
                "pending"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "provenance_recorded_fail_closed",
            "verified_playable",
            "pending",
            "failed",
            "provenance_recorded_production_stash_loaded",
            "provenance_recorded_linux_only_windows_scaffold_pending"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "verificationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "runtime-load",
            "symbol-probe",
            "detour-self-test",
            "stash-detour-self-test",
            "stash-hook",
            "release-provenance",
            "stash-detour-install",
            "stash-core-detour-install",
            "stash-access-placement-detour-install",
            "stash-access-placement-self-test",
            "stash-placement-discovery",
            "stash-core-behavior"
          ]
        },
        "path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "status": {
          "type": "string",
          "enum": [
            "schema_defined",
            "current_fail_closed",
            "pending_capture",
            "passed",
            "failed",
            "historical_passed_fail_closed_diagnostic",
            "current_loaded_for_validated_stash_manifest"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "patchArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "checksum",
        "appliesTo",
        "baseRevision",
        "required",
        "providesCapabilities",
        "verificationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "appliesTo": {
          "type": "string",
          "minLength": 1
        },
        "baseRevision": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "providesCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "semantic_reference_only",
            "artifact_present",
            "applied_to_verified_source",
            "pending"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "buildArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "path",
        "status"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/repoRelativePath"
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "placeholder_pending_built_game",
            "verified",
            "missing"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "platformRuntimeSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "hostOs",
        "gameExecutableName",
        "launchAdapter",
        "artifactExtension",
        "status"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "hostOs": {
          "type": "string",
          "enum": [
            "linux",
            "windows",
            "macos"
          ]
        },
        "cpuArch": {
          "type": "string",
          "minLength": 1
        },
        "gameExecutableName": {
          "type": "string",
          "minLength": 1
        },
        "launchAdapter": {
          "type": "string",
          "enum": [
            "linux-ld-preload",
            "windows-createprocess-loadlibrary"
          ]
        },
        "hookArtifact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artifactExtension": {
          "type": "string",
          "minLength": 1
        },
        "hookLibraryName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "launcherExecutable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "launcherPath": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
