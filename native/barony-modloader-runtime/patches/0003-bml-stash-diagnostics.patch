+void appendDiagnosticLine(const std::string& event, const std::string& details)
+{
+	if (gStashStateRootPath.empty())
+	{
+		return;
+	}
+	const std::string path = joinPath(gStashStateRootPath, "stash-diagnostics.jsonl");
+	if (!ensureDirectory(directoryName(path)))
+	{
+		return;
+	}
+	std::ofstream out(path.c_str(), std::ios::out | std::ios::app | std::ios::binary);
+	if (!out)
+	{
+		return;
+	}
+	out << "{\"event\":\"" << event << "\"," << details << "}\n";
+}
