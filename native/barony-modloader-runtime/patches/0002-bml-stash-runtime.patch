+std::string stateRootPathForManifest(const std::string& manifestText, const std::string& outputDir)
+{
+	std::string stateRoot;
+	if (extractStringField(manifestText, "stateRoot", stateRoot) && !stateRoot.empty())
+	{
+		return joinPath(outputDir, stateRoot);
+	}
+	return joinPath(outputDir, kDefaultStateRoot);
+}
+
+std::string stashInventoryPath()
+{
+	return joinPath(gStashStateRootPath, kStashInventoryFileName);
+}
+
+void resetStashRuntimeState()
+{
+	gStashRuntimeActive = false;
+	gStashInventoryDirty = false;
+	gStashInventoryLoaded = false;
+	list_FreeAll(&gStashInventory);
+	gStashInventory.first = nullptr;
+	gStashInventory.last = nullptr;
+}
+
+bool readPersistentInventoryFile(const std::string& path, list_t* inventory)
+{
+	std::string content;
+	if (!readFile(path, content))
+	{
+		return false;
+	}
+
+	std::istringstream rows(content);
+	std::string row;
+	while (std::getline(rows, row))
+	{
+		if (row.empty() || row[0] == '#')
+		{
+			continue;
+		}
+		int type = 0;
+		int status = 0;
+		int beatitude = 0;
+		int count = 0;
+		Uint32 appearance = 0;
+		int identified = 0;
+		std::istringstream fields(row);
+		if (fields >> type >> status >> beatitude >> count >> appearance >> identified)
+		{
+			newItem(static_cast<ItemType>(type),
+				static_cast<Status>(status),
+				static_cast<Sint16>(beatitude),
+				static_cast<Sint16>(std::max(1, count)),
+				appearance,
+				identified != 0,
+				inventory);
+		}
+	}
+	return true;
+}
+
+std::string persistentInventoryFileContents(list_t* inventory)
+{
+	std::ostringstream out;
+	out << "# bml-stash-inventory-v1\n";
+	for (node_t* node = inventory ? inventory->first : nullptr; node != nullptr; node = node->next)
+	{
+		Item* item = static_cast<Item*>(node->element);
+		if (!item)
+		{
+			continue;
+		}
+		out << static_cast<int>(item->type) << ' '
+			<< static_cast<int>(item->status) << ' '
+			<< static_cast<int>(item->beatitude) << ' '
+			<< static_cast<int>(item->count) << ' '
+			<< item->appearance << ' '
+			<< (item->identified ? 1 : 0) << "\n";
+	}
+	return out.str();
+}
+
+void configureStashRuntime(const std::string& stateRootPath)
+{
+	gStashRuntimeActive = true;
+	gStashStateRootPath = stateRootPath;
+	gStashInventoryLoaded = false;
+	gStashInventoryDirty = false;
+}
+
+bool nearbyStashAccessPointExists(double x, double y)
+{
+	for (node_t* node = map.entities ? map.entities->first : nullptr; node != nullptr; node = node->next)
+	{
+		Entity* entity = static_cast<Entity*>(node->element);
+		if (!entity || entity->behavior != &actChest || entity->chestVoidState == 0)
+		{
+			continue;
+		}
+		const double dx = entity->x - x;
+		const double dy = entity->y - y;
+		if ((dx * dx + dy * dy) < (32.0 * 32.0))
+		{
+			return true;
+		}
+	}
+	return false;
+}
