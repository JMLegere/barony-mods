+}
+
+bool isStashRuntimeActive()
+{
+	return gStashRuntimeActive;
+}
+
+void loadPersistentStashInventoryIfNeeded()
+{
+	if (!gStashRuntimeActive || gStashInventoryLoaded)
+	{
+		return;
+	}
+
+	list_FreeAll(&gStashInventory);
+	gStashInventory.first = nullptr;
+	gStashInventory.last = nullptr;
+	readPersistentInventoryFile(stashInventoryPath(), &gStashInventory);
+	gStashInventoryLoaded = true;
+	gStashInventoryDirty = false;
+}
+
+list_t* getStashInventory()
+{
+	if (!gStashRuntimeActive)
+	{
+		return nullptr;
+	}
+	loadPersistentStashInventoryIfNeeded();
+	return &gStashInventory;
+}
+
+void markStashInventoryDirty()
+{
+	if (gStashRuntimeActive)
+	{
+		gStashInventoryDirty = true;
+	}
+}
+
+bool savePersistentStashInventoryIfDirty()
+{
+	if (!gStashRuntimeActive)
+	{
+		return true;
+	}
+	loadPersistentStashInventoryIfNeeded();
+	if (!gStashInventoryDirty)
+	{
+		return true;
+	}
+	if (!ensureDirectory(gStashStateRootPath))
+	{
+		return false;
+	}
+	if (!writeFile(stashInventoryPath(), persistentInventoryFileContents(&gStashInventory)))
+	{
+		return false;
+	}
+	gStashInventoryDirty = false;
+	return true;
+}
+
+std::string runtimeMetadataValue()
+{
+	return std::string("runtime=") + kRuntimeId
+		+ ";runtime_version=" + kRuntimeVersion
+		+ ";inventory_schema=" + kStashInventorySchema
+		+ ";capabilities=persistent_storage,persistent_inventory,void_chest_binding,placement_lobby,placement_shop,multiplayer_version_metadata";
+}
+
+bool saveMetadataMatchesActiveRuntime(const std::string& metadata)
+{
+	return metadata.empty() || metadata == runtimeMetadataValue();
+}
+
+Entity* requestStashAccessPoint(Entity* anchor, StashAccessPointKind kind)
+{
+	if (!anchor)
+	{
+		return nullptr;
+	}
+	const double offset = kind == StashAccessPointKind::LobbyAssist ? 32.0 : 0.0;
+	return requestStashAccessPoint(anchor->x + offset, anchor->y, anchor->yaw, kind);
+}
+
+Entity* requestStashAccessPoint(double x, double y, double yaw, StashAccessPointKind kind)
+{
+	if (!gStashRuntimeActive || multiplayer == CLIENT || !map.entities)
+	{
+		return nullptr;
+	}
+	if (nearbyStashAccessPointExists(x, y))
+	{
+		return nullptr;
+	}
+
+	Entity* chest = newEntity(1791, 1, map.entities, nullptr);
+	setSpriteAttributes(chest, nullptr, nullptr);
+	chest->x = x;
+	chest->y = y;
+	chest->z = 6;
+	chest->sizex = 3;
+	chest->sizey = 2;
+	chest->yaw = yaw;
+	chest->behavior = &actChest;
+	chest->sprite = 1791;
+	chest->chestInit = 1;
+	chest->chestHealth = 9999;
+	chest->chestMaxHealth = 9999;
+	chest->chestOldHealth = chest->chestHealth;
+	chest->chestLocked = 0;
+	chest->chestPreventLockpickCapstoneExploit = 1;
+	chest->chestLockpickHealth = 0;
+	chest->chestVoidState = -1; // Permanent Stash access; spell-created Void Chests still use their timer.
+	chest->seedEntityRNG(map_server_rng.getU32());
+
+	Entity* lid = newEntity(1790, 0, map.entities, nullptr);
+	setSpriteAttributes(lid, nullptr, nullptr);
+	lid->parent = chest->getUID();
+	chest->parent = lid->getUID();
+	lid->x = chest->x;
+	lid->y = chest->y - 3;
+	lid->z = chest->z - 2.75;
+	lid->focalx = 3;
+	lid->focalz = -.75;
+	lid->yaw = chest->yaw;
+	lid->sizex = 2;
+	lid->sizey = 2;
+	lid->behavior = &actChestLid;
+	lid->flags[PASSABLE] = true;
+	TileEntityList.addEntity(*lid);
+
+	node_t* tempNode = list_AddNodeFirst(&chest->children);
+	tempNode->element = nullptr;
+	tempNode->deconstructor = &emptyDeconstructor;
+	return chest;
 }
 
