+
+std::string jsonEscape(const std::string& value)
+{
+	std::string escaped;
+	escaped.reserve(value.size());
+	for (const char ch : value)
+	{
+		if (ch == '"')
+		{
+			escaped += "\\\"";
+		}
+		else if (ch == '\n')
+		{
+			escaped += "\\n";
+		}
+		else if (ch == '\r')
+		{
+			escaped += "\\r";
+		}
+		else if (ch == '\t')
+		{
+			escaped += "\\t";
+		}
+		else
+		{
+			escaped += ch;
+		}
+	}
+	return escaped;
+}
+
+std::string directoryName(const std::string& path)
+{
+	const std::string::size_type slash = path.find_last_of('/');
+	if (slash == std::string::npos)
+	{
+		return ".";
+	}
+	if (slash == 0)
+	{
+		return path.substr(0, 1);
+	}
+	return path.substr(0, slash);
+}
+
+std::string joinPath(const std::string& base, const std::string& child)
+{
+	if (child.empty() || child[0] == '/' || (child.size() > 2 && child[1] == ':'))
+	{
+		return child;
+	}
+	if (base.empty())
+	{
+		return child;
+	}
+	return base[base.size() - 1] == '/' ? base + child : base + "/" + child;
+}
+
+bool ensureDirectory(const std::string& path)
+{
+	if (path.empty() || path == ".")
+	{
+		return true;
+	}
+
+	std::string partial;
+	std::string::size_type index = path[0] == '/' ? 1 : 0;
+	if (path[0] == '/')
+	{
+		partial = "/";
+	}
+	while (index < path.size())
+	{
+		const std::string::size_type next = path.find('/', index);
+		const std::string part = path.substr(index, next == std::string::npos ? std::string::npos : next - index);
+		if (!part.empty())
+		{
+			if (!partial.empty() && partial[partial.size() - 1] != '/')
+			{
+				partial += '/';
+			}
+			partial += part;
+			if (BML_MKDIR(partial.c_str()) != 0 && errno != EEXIST)
+			{
+				return false;
+			}
+		}
+		if (next == std::string::npos)
+		{
+			break;
+		}
+		index = next + 1;
+	}
+	return true;
+}
+
+bool writeFile(const std::string& path, const std::string& content)
+{
+	if (!ensureDirectory(directoryName(path)))
+	{
+		return false;
+	}
+	std::ofstream out(path.c_str(), std::ios::out | std::ios::trunc | std::ios::binary);
+	if (!out)
+	{
+		return false;
+	}
+	out << content;
+	return static_cast<bool>(out);
+}
+
+bool readFile(const std::string& path, std::string& content)
+{
+	std::ifstream in(path.c_str(), std::ios::in | std::ios::binary);
+	if (!in)
+	{
+		return false;
+	}
+	std::ostringstream buffer;
+	buffer << in.rdbuf();
+	content = buffer.str();
+	return static_cast<bool>(in) || in.eof();
+}
+
+bool containsJsonString(const std::string& text, const std::string& value)
+{
+	return text.find("\"" + value + "\"") != std::string::npos;
+}
+
+bool extractStringField(const std::string& text, const std::string& field, std::string& value)
+{
+	const std::string fieldNeedle = "\"" + field + "\"";
+	const std::string::size_type fieldPos = text.find(fieldNeedle);
+	if (fieldPos == std::string::npos)
+	{
+		return false;
+	}
+	const std::string::size_type colon = text.find(':', fieldPos + fieldNeedle.size());
+	if (colon == std::string::npos)
+	{
+		return false;
+	}
+	const std::string::size_type open = text.find('"', colon + 1);
+	if (open == std::string::npos)
+	{
+		return false;
+	}
+	const std::string::size_type close = text.find('"', open + 1);
+	if (close == std::string::npos)
+	{
+		return false;
+	}
+	value = text.substr(open + 1, close - open - 1);
+	return true;
+}
+
+std::string defaultReportPath(const std::string& manifestPath)
+{
+	return joinPath(directoryName(manifestPath), "runtime-load-report.json");
+}
+
+std::string reportPathForManifest(const std::string& manifestText, const std::string& manifestPath, const std::string& outputDir)
+{
+	std::string runtimeLoadReport;
+	if (extractStringField(manifestText, "runtimeLoadReport", runtimeLoadReport) && !runtimeLoadReport.empty())
+	{
+		return joinPath(outputDir, runtimeLoadReport);
+	}
+	return defaultReportPath(manifestPath);
+}
+
+std::string runtimeReportJson(const std::string& manifestPath, const std::string& status, const std::string& errorCode, const std::string& errorMessage)
+{
+	std::ostringstream out;
+	out << "{\n";
+	out << "  \"contract\": {\"id\": \"" << kContractId << "\", \"version\": \"" << kContractVersion << "\"},\n";
+	out << "  \"runtime\": {\"id\": \"" << kRuntimeId << "\", \"version\": \"" << kRuntimeVersion << "\"},\n";
+	out << "  \"manifestPath\": \"" << jsonEscape(manifestPath) << "\",\n";
+	out << "  \"status\": \"" << status << "\",\n";
+	out << "  \"loaded\": " << (status == "loaded" ? "true" : "false") << ",\n";
+	out << "  \"errorCode\": \"" << errorCode << "\",\n";
+	out << "  \"errorMessage\": \"" << jsonEscape(errorMessage) << "\",\n";
+	out << "  \"capabilities\": [\n";
+	for (size_t index = 0; index < sizeof(kCapabilities) / sizeof(kCapabilities[0]); ++index)
+	{
+		out << "    {\"id\": \"" << kCapabilities[index] << "\", \"version\": \"0.1.0\", \"status\": \"" << status << "\"}";
+		if (index + 1 < sizeof(kCapabilities) / sizeof(kCapabilities[0]))
+		{
+			out << ",";
+		}
+		out << "\n";
+	}
+	out << "  ]\n";
+	out << "}\n";
+	return out.str();
+}
+
+RuntimeManifestLoadResult resultFor(const std::string& manifestPath, const std::string& reportPath, const std::string& status, const std::string& errorCode, const std::string& errorMessage)
+{
+	RuntimeManifestLoadResult result;
+	result.loaded = status == "loaded";
+	result.status = status;
+	result.errorCode = errorCode;
+	result.errorMessage = errorMessage;
+	result.manifestPath = manifestPath;
+	result.reportPath = reportPath;
+	return result;
+}
+
+RuntimeManifestLoadResult writeReportResult(const std::string& manifestPath, const std::string& reportPath, const std::string& status, const std::string& errorCode, const std::string& errorMessage)
+{
+	if (!writeFile(reportPath, runtimeReportJson(manifestPath, status, errorCode, errorMessage)))
+	{
+		return resultFor(manifestPath, reportPath, "failed", "BML_REPORT_WRITE_FAILED", "Could not write runtime-load-report.json");
+	}
+	return resultFor(manifestPath, reportPath, status, errorCode, errorMessage);
+}
+
+} // namespace
+
+int writeRuntimeInfo(const std::string& outputPath)
+{
+	if (outputPath.empty())
+	{
+		std::printf("%s\n", kRuntimeInfoJson);
+		return 0;
+	}
+	if (!writeFile(outputPath, std::string(kRuntimeInfoJson) + "\n"))
+	{
+		std::fprintf(stderr, "BaronyModLoader: failed to write runtime info to %s\n", outputPath.c_str());
+		return 1;
+	}
+	return 0;
+}
+
+RuntimeManifestLoadResult loadRuntimeManifest(const std::string& manifestPath, const std::string& outputDir)
+{
+	const std::string fallbackReportPath = defaultReportPath(manifestPath);
+	std::string manifestText;
+	if (!readFile(manifestPath, manifestText))
+	{
+		return writeReportResult(manifestPath, fallbackReportPath, "failed", "BML_MANIFEST_READ_FAILED", "Could not read runtime manifest");
+	}
+
+	const std::string reportPath = reportPathForManifest(manifestText, manifestPath, outputDir);
+	if (!containsJsonString(manifestText, "contract"))
+	{
+		return writeReportResult(manifestPath, reportPath, "failed", "BML_CONTRACT_MISSING", "Manifest is missing contract object");
+	}
+	if (!containsJsonString(manifestText, kContractId) || !containsJsonString(manifestText, kContractVersion))
+	{
+		return writeReportResult(manifestPath, reportPath, "failed", "BML_CONTRACT_UNSUPPORTED", "Manifest contract id/version is not supported by this runtime");
+	}
+
+	for (size_t index = 0; index < sizeof(kCapabilities) / sizeof(kCapabilities[0]); ++index)
+	{
+		if (!containsJsonString(manifestText, kCapabilities[index]))
+		{
+			return writeReportResult(manifestPath, reportPath, "failed", "BML_CAPABILITY_MISSING", std::string("Manifest is missing required capability: ") + kCapabilities[index]);
+		}
+	}
+
+	return writeReportResult(manifestPath, reportPath, "loaded", "BML_OK", "");
+}
+
+} // namespace BaronyModLoader
